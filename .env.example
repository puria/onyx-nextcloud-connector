# Nextcloud (create the app password under Settings -> Security -> Devices & sessions)
NC_URL=https://cloud.example.com
NC_USERNAME=me
NC_APP_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx
# Folder allowlist, comma-separated, relative to the user's WebDAV root
NC_FOLDERS=Documents,Projects/Notes
# Verify TLS certificates (set to 0 only for local testing with self-signed certs)
NC_VERIFY_TLS=1

# Onyx API (create the API key under Admin Panel -> API Keys; needs manage:connectors permission)
ONYX_URL=https://onyx.example.com/api
ONYX_API_KEY=your-api-key
# Push documents as publicly visible (0 = restricted/private in a single-person instance)
ONYX_DOC_PUBLIC=0
# Verify TLS certificates for Onyx as well
ONYX_VERIFY_TLS=1

# Daemon interval in seconds (default 10 minutes)
SYNC_INTERVAL_SECONDS=600
# Largest file to download and ingest, in megabytes
MAX_FILE_MB=25
# SQLite database location (keep on the persistent volume)
STATE_PATH=/data/state.db
LOG_LEVEL=INFO
