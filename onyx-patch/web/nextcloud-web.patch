@@ -0,0 +1,191 @@
+"use client";
+
+import { useState } from "react";
+import { useTranslations } from "next-intl";
+import { useFormikContext } from "formik";
+import { Button } from "@opal/components";
+import { InputVertical } from "@opal/layouts";
+import Text from "@/refresh-components/texts/Text";
+
+interface NextcloudFolder {
+  name: string;
+  path: string;
+}
+
+interface FolderPickerInputProps {
+  name: string;
+  label: string;
+  description?: string;
+  credentialId?: number;
+  verifySsl?: boolean;
+}
+
+/**
+ * Folder browser for the Nextcloud connector.
+ *
+ * Lists folders through `/api/manage/admin/nextcloud/browse`, which reads the
+ * already-stored credential server-side. Selected folders are written back into
+ * the form as a list of paths.
+ */
+export default function FolderPickerInput({
+  name,
+  label,
+  description,
+  credentialId,
+  verifySsl,
+}: FolderPickerInputProps) {
+  const t = useTranslations("admin.connectorsList.folderPicker");
+  const { values, setFieldValue } = useFormikContext<Record<string, any>>();
+  const selected: string[] = Array.isArray(values[name]) ? values[name] : [];
+
+  const [path, setPath] = useState<string | null>(null);
+  const [folders, setFolders] = useState<NextcloudFolder[]>([]);
+  const [loading, setLoading] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  const load = async (target: string) => {
+    if (!credentialId) {
+      setError(t("needsCredential.label"));
+      return;
+    }
+    setLoading(true);
+    setError(null);
+    try {
+      const response = await fetch("/api/manage/admin/nextcloud/browse", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({
+          credential_id: credentialId,
+          path: target,
+          verify_ssl: verifySsl ?? true,
+        }),
+      });
+      if (!response.ok) {
+        const detail = await response.text();
+        setError(detail.slice(0, 300) || `HTTP ${response.status}`);
+        setFolders([]);
+        return;
+      }
+      const data = await response.json();
+      setFolders(data.folders ?? []);
+      setPath(data.path ?? "");
+    } catch (caught) {
+      setError(String(caught).slice(0, 300));
+    } finally {
+      setLoading(false);
+    }
+  };
+
+  const addFolder = (folder: string) => {
+    if (!folder || selected.includes(folder)) return;
+    setFieldValue(name, [...selected, folder]);
+  };
+
+  const removeFolder = (folder: string) => {
+    setFieldValue(
+      name,
+      selected.filter((item) => item !== folder),
+    );
+  };
+
+  const current = path ?? "";
+  const parent = current.includes("/")
+    ? current.slice(0, current.lastIndexOf("/"))
+    : "";
+
+  return (
+    <InputVertical withLabel={name} title={label} description={description}>
+      <div className="flex flex-col gap-2">
+        {selected.length > 0 && (
+          <div className="flex flex-wrap gap-1">
+            {selected.map((folder) => (
+              <Button
+                key={folder}
+                prominence="secondary"
+                size="sm"
+                onClick={() => removeFolder(folder)}
+              >
+                {`${folder} ✕`}
+              </Button>
+            ))}
+          </div>
+        )}
+
+        <div className="flex flex-wrap gap-1">
+          <Button
+            prominence="secondary"
+            size="sm"
+            disabled={loading}
+            onClick={() => load(current)}
+          >
+            {path === null ? t("browseButton.label") : t("refreshButton.label")}
+          </Button>
+          {path !== null && (
+            <Button
+              prominence="tertiary"
+              size="sm"
+              onClick={() => addFolder(current)}
+            >
+              {t("addCurrentButton.label")}
+            </Button>
+          )}
+        </div>
+
+        {path !== null && (
+          <Text text03 secondaryBody>
+            {`/${current}`}
+            {loading ? ` — ${t("loading.label")}` : ""}
+          </Text>
+        )}
+
+        {error && (
+          <Text text03 secondaryBody>
+            {`${t("errorPrefix.label")} ${error}`}
+          </Text>
+        )}
+
+        {folders.length > 0 && (
+          <div className="flex flex-col gap-1">
+            {current !== "" && (
+              <Button
+                prominence="tertiary"
+                size="sm"
+                onClick={() => load(parent)}
+              >
+                {t("upButton.label")}
+              </Button>
+            )}
+            {folders.map((folder) => (
+              <div
+                key={folder.path}
+                className="flex flex-wrap items-center gap-1"
+              >
+                <Button
+                  prominence="tertiary"
+                  size="sm"
+                  onClick={() => load(folder.path)}
+                >
+                  {`📁 ${folder.name}`}
+                </Button>
+                <Button
+                  prominence="secondary"
+                  size="sm"
+                  disabled={selected.includes(folder.path)}
+                  onClick={() => addFolder(folder.path)}
+                >
+                  {t("selectButton.label")}
+                </Button>
+              </div>
+            ))}
+          </div>
+        )}
+
+        {path !== null && !loading && folders.length === 0 && !error && (
+          <Text text03 secondaryBody>
+            {t("empty.label")}
+          </Text>
+        )}
+      </div>
+    </InputVertical>
+  );
+}
